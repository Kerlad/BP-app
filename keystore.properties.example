# Copy to `keystore.properties` (it is in .gitignore) and fill in. Never commit the real file or the keystore.
# Without it the release build is built but not signed. On CI the same values come from the repository secrets
# BP_STORE_FILE (a path), BP_STORE_PASSWORD, BP_KEY_ALIAS, BP_KEY_PASSWORD, see .github/workflows/release.yml.
storeFile=../upload-keystore.jks
storePassword=
keyAlias=
keyPassword=
